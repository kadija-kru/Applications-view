{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "app-tiles-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/appTiles/AppTilesWebPart.js",
          "manifest": "./src/webparts/appTiles/AppTilesWebPart.manifest.json",
          "outputPath": "./dist/app-tiles.js"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "AppTilesWebPartStrings": "lib/webparts/appTiles/loc/{locale}.js",
    "PropertyControlStrings": "node_modules/@pnp/spfx-property-controls/lib/loc/{locale}.js"
  }
}