{
  "name": "app-tiles-webpart",
  "version": "1.0.0",
  "description": "SPFx webpart for displaying configurable application tiles",
  "main": "lib/index.js",
  "private": true,
  "engines": {
    "node": ">=16.13.0 <19.0.0"
  },
  "scripts": {
    "build": "node scripts/check-dependencies.js && gulp bundle",
    "clean": "node scripts/check-dependencies.js && gulp clean",
    "serve": "node scripts/check-dependencies.js && gulp serve",
    "ship": "node scripts/check-dependencies.js && gulp bundle --ship && gulp package-solution --ship",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-core-library": "1.18.2",
    "@microsoft/sp-lodash-subset": "1.18.2",
    "@microsoft/sp-office-ui-fabric-core": "1.18.2",
    "@microsoft/sp-property-pane": "1.18.2",
    "@microsoft/sp-webpart-base": "1.18.2",
    "@pnp/spfx-property-controls": "^3.15.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.18.2",
    "@microsoft/eslint-plugin-spfx": "1.18.2",
    "@microsoft/rush-stack-compiler-4.7": "0.1.0",
    "@microsoft/sp-build-web": "1.18.2",
    "@microsoft/sp-module-interfaces": "1.18.2",
    "@rushstack/eslint-config": "2.5.1",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "ajv": "^6.12.5",
    "eslint": "8.7.0",
    "eslint-plugin-react-hooks": "4.3.0",
    "gulp": "4.0.2",
    "spfx-fast-serve-helpers": "~1.18.0",
    "typescript": "4.7.4"
  }
}
